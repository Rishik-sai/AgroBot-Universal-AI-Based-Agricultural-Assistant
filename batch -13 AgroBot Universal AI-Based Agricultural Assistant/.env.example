# Copy to .env and fill in real values. Never commit .env.

# Flask session signing key - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me

# Set to 1 for the local auto-reloader. Must stay 0/unset in production.
FLASK_DEBUG=0

# Google Gemini API key - https://aistudio.google.com/apikey
# Leave blank to run without AI chat; all other features still work.
GEMINI_API_KEY=

# Comma-separated, first is preferred and the rest are fallbacks.
# gemini-2.5-* are retired for new keys - do not use them.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.1-flash-lite

# OpenWeatherMap API key - https://openweathermap.org/api
WEATHER_API_KEY=

# Passwords for the admin/demo accounts seeded on first DB creation.
# If unset, a random password is generated and printed to the startup log.
ADMIN_PASSWORD=
DEMO_PASSWORD=

# Postgres connection string. Leave unset to fall back to local SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
